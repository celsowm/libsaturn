diff --git a/libs/ymir-core/include/ymir/hw/sh2/sh2.hpp b/libs/ymir-core/include/ymir/hw/sh2/sh2.hpp
--- a/libs/ymir-core/include/ymir/hw/sh2/sh2.hpp
