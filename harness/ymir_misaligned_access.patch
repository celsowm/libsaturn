diff --git a/libs/ymir-core/include/ymir/hw/sh2/sh2.hpp b/libs/ymir-core/include/ymir/hw/sh2/sh2.hpp
--- a/libs/ymir-core/include/ymir/hw/sh2/sh2.hpp
+++ b/libs/ymir-core/include/ymir/hw/sh2/sh2.hpp
@@ -131,6 +131,37 @@ public:
         }
     }
 
+    // --- Misaligned data accesses (a CPU address error on hardware; aligned down here)
+
+    struct MisalignedAccess {
+        uint32 pc;
+        uint32 address;
+        uint8 size;
+        bool write;
+    };
+    struct MisalignedLog {
+        uint64 count = 0;
+        uint32 stored = 0; // distinct PCs kept in `first`
+        std::array<MisalignedAccess, 64> first{};
+    };
+    [[nodiscard]] const MisalignedLog &GetMisalignedLog() const noexcept {
+        return m_misaligned;
+    }
+
+private:
+    MisalignedLog m_misaligned{};
+    void NoteMisaligned(uint32 address, uint8 size, bool write) {
+        ++m_misaligned.count;
+        for (uint32 i = 0; i < m_misaligned.stored; ++i) {
+            if (m_misaligned.first[i].pc == PC) {
+                return;
+            }
+        }
+        if (m_misaligned.stored < m_misaligned.first.size()) {
+            m_misaligned.first[m_misaligned.stored++] = {PC, address, size, write};
+        }
+    }
+
     // --- Breakpoints
 
 private:
diff --git a/libs/ymir-core/src/ymir/hw/sh2/sh2.cpp b/libs/ymir-core/src/ymir/hw/sh2/sh2.cpp
--- a/libs/ymir-core/src/ymir/hw/sh2/sh2.cpp
+++ b/libs/ymir-core/src/ymir/hw/sh2/sh2.cpp
@@ -643,6 +643,9 @@ T SH2::MemRead(uint32 address) {
                                     sizeof(T) * 8, address);
             // TODO: raise CPU address error due to misaligned access
             // - might have to store data in a class member instead of returning
+            if constexpr (!instrFetch) {
+                NoteMisaligned(address, static_cast<uint8>(sizeof(T)), false);
+            }
         }
         address &= kAddressMask;
     }
@@ -766,6 +769,7 @@ void SH2::MemWrite(uint32 address, T value) {
             devlog::trace<grp::mem>(m_logPrefix, "[PC = {:08X}] WARNING: misaligned {}-bit write to {:08X} = {:X}", PC,
                                     sizeof(T) * 8, address, value);
             // TODO: address error (misaligned access)
+            NoteMisaligned(address, static_cast<uint8>(sizeof(T)), true);
         }
         address &= kAddressMask;
     }
