*.bin
!assets/boot/ip_yaul_template.bin
# bullet_hell_stress vendors the shmup v4 asset pack: the PNG half under
# examples/bullet_hell_stress/assets/ is tracked, and its binary half
# (palette_bgr555_be.bin, vdp1/index8/, vdp1/lut4/) is source data the pack
# step reads, not a build output. tools/shmup_assets.py pack fails in a clean
# clone without it, which broke the CI cross-build gate.
!examples/bullet_hell_stress/assets/**/*.bin
*.iso
*.map
*.cue
*.log
*.tmp
*.cache
__pycache__/
*.pyc
.pytest_cache/
out/
toolchain-src/
!assets/boot/ip_sbl_template.bin
emulators/kronos/*.exe
emulators/kronos/*.dll
emulators/kronos/*.zip
emulators/kronos/*.txt
emulators/kronos/*.html
emulators/kronos/platforms/
emulators/kronos/trans/
emulators/mednafen/*.zip
emulators/mednafen/*.7z
emulators/mednafen/run-mednafen.ps1
emulators/kronos/run-kronos.ps1
emulators/YabaSanshiro/*
!emulators/YabaSanshiro/run-yabasanshiro.ps1
emulator_screenshot.png
kronos_rbg0.png
smoke_hello.png
smoke_nbg0.png
vdp2_infinite_plane_fixed.png
vdp2_infinite_plane_scrolled.png
yaba_rbg0.png
run_vdp2_simulation.py
bios/
