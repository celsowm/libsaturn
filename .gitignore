!assets/prebuilt/
.opencode/

# Generated/test artifacts never belong at the repository root. Legitimate
# fixtures live under tests/fixtures/ or assets/ with a named owner.
/$tmp/
/ip.bin
/probe.json
/vdp1-debug.bin
/iso_root*/
/bisect/
/build_log.txt
/dist/

# Stray runtime captures from emulator/test sweeps. These accidentally land
# at the repo root during accept runs and must never enter the history.
/.err
/.out

# probe.json files are runtime snapshots under docs/.../*/hon/, not source.
/docs/**/probe.json

# Package build and install trees
/test_package/build/
/CMakeUserPresets.json

# Editor config with absolute paths, written by tools/gen_clangd.py
/.clangd
