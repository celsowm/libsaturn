# Pad script for the harness probe ("FRAME BUTTONS", held until the next line): plays the whole
# high_speed_platformer stage with one short jump -- the dash pads and the loop do the rest -- and
# reaches the finish line after about 305 game ticks (tests/host/test_high_speed_platformer.cpp
# plays the same input through the simulation).
#
#   probe.exe --iso build/examples/high_speed_platformer.iso --bios bios/saturn_bios_us.bin \
#     --bin build/examples/high_speed_platformer.app.bin --frames 500 --boot-frames 90 \
#     --pad-script examples/high_speed_platformer/harness/high_speed_platformer.pad --screenshot 450:shot.png
0 RIGHT
118 RIGHT+A
120 RIGHT
